# Copy this file to .env before running Docker Compose.
# Replace JWT_SECRET with a random value containing at least 32 characters.
# Fill in GEMINI_API_KEY and GEMINI_MODEL before using AI-powered feeds.
# In Vercel, DATABASE_URL must point to Supabase PostgreSQL, not to the db host.
# Production must use NODE_ENV=production and SEED_ENABLED=false.
# Demo credentials below are exclusively for the local environment.

# Application
NODE_ENV=development
APP_URL=http://localhost:3000
APP_PORT=3000

# Local PostgreSQL container
POSTGRES_DB=radarinvest
POSTGRES_USER=radarinvest
POSTGRES_PASSWORD=radarinvest_local
DATABASE_URL=postgresql://radarinvest:radarinvest_local@db:5432/radarinvest
# Optional outside local development. Production migrations use the GitHub
# Environment secret MIGRATION_DATABASE_URL with the Supabase Session pooler.
MIGRATION_DATABASE_URL=

# Authentication
JWT_SECRET=
JWT_ISSUER=radarinvest-ai
JWT_AUDIENCE=radarinvest-web
JWT_EXPIRES_IN=1h
PASSWORD_HASH_COST=12

# Local idempotent seed (must be false in production)
SEED_ENABLED=true
SEED_USER_NAME=Usuário Demo
SEED_USER_EMAIL=demo@radarinvest.local
SEED_USER_PASSWORD=Demo@123456
SEED_USER_INTERESTS=PETR4,VALE3,taxa Selic

# AI
AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=
GEMINI_TIMEOUT_MS=15000

# News
NEWS_PROVIDER=infomoney
INFOMONEY_RSS_URL=https://www.infomoney.com.br/feed/
NEWS_TIMEOUT_MS=5000
NEWS_MAX_ITEMS=20

# Feed
FEED_TIMEZONE=America/Sao_Paulo
FEED_REFRESH_COOLDOWN_SECONDS=60
