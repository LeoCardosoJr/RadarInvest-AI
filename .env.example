# Copy this file to .env before running Docker Compose.
# Replace JWT_SECRET with a random value containing at least 32 characters.
# Fill in GEMINI_API_KEY and GEMINI_MODEL before using AI-powered feeds.
# In Vercel, DATABASE_URL must point to Supabase PostgreSQL, not to the db host.
# Production must use NODE_ENV=production and SEED_ENABLED=false.
# Demo credentials below are exclusively for the local environment.

# Application
NODE_ENV=development
APP_URL=http://localhost:3000
APP_PORT=3000

# Local PostgreSQL container
POSTGRES_DB=radarinvest
POSTGRES_USER=radarinvest
POSTGRES_PASSWORD=radarinvest_local
POSTGRES_PORT=5432
DATABASE_URL=postgresql://radarinvest:radarinvest_local@db:5432/radarinvest
# Optional outside local development. Production migrations use the GitHub
# Environment secret MIGRATION_DATABASE_URL with the Supabase Session pooler.
MIGRATION_DATABASE_URL=

# Authentication
JWT_SECRET=
JWT_ISSUER=radarinvest-ai
JWT_AUDIENCE=radarinvest-web
JWT_EXPIRES_IN=1h
PASSWORD_HASH_COST=12

# Password recovery
PASSWORD_RESET_TOKEN_TTL_MINUTES=30
PASSWORD_RESET_COOLDOWN_SECONDS=60

# Transactional SMTP for the recovery e-mail.
# Leave every field empty to keep recovery non-operational: the token is
# generated and consumed by the API, but no message is delivered.
# Fill SMTP_HOST, SMTP_PORT and PASSWORD_RESET_FROM_EMAIL together.
# SMTP_USER and SMTP_PASSWORD are optional, but must be provided as a pair.
# These values stay on the server; never expose them to the browser.
SMTP_HOST=
SMTP_PORT=
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
PASSWORD_RESET_FROM_EMAIL=

# Local idempotent seed (must be false in production)
SEED_ENABLED=true
SEED_USER_NAME=Usuário Demo
SEED_USER_EMAIL=demo@radarinvest.local
SEED_USER_PASSWORD=Demo@123456
SEED_USER_INTERESTS=PETR4,VALE3,taxa Selic

# AI
AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
GEMINI_TIMEOUT_MS=15000

# News
# Fonte: API pública (REST JSON) do WordPress que hospeda o InfoMoney, não o feed RSS.
# NEWS_MAX_ITEMS também é usado como per_page da busca (teto de 100 itens por requisição).
NEWS_PROVIDER=infomoney
INFOMONEY_API_URL=https://www.infomoney.com.br/wp-json/wp/v2/posts
NEWS_TIMEOUT_MS=5000
NEWS_MAX_ITEMS=100

# Feed
FEED_TIMEZONE=America/Sao_Paulo
FEED_REFRESH_COOLDOWN_SECONDS=60
